# ════════════════════════════════════════════════════════════════
#  Real Estate Hybrid Multimodal RAG — Environment Variables
#  Copy this file to .env and fill in your actual values.
# ════════════════════════════════════════════════════════════════

# ── Groq LLM ────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=real_estate_chatbot
MONGODB_COLLECTION=projects
# Set to true to allow local metadata fallback if MongoDB is unreachable
ALLOW_UPLOAD_WITHOUT_MONGODB=false


# ── Qdrant Vector Database ───────────────────────────────────────
# Start Qdrant locally:  docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=real_estate_text_chunks
QDRANT_COLLECTION_IMAGES=real_estate_image_chunks

# ── Embedding Models (downloaded from HuggingFace on first run) ──
# bge-m3: ~2.3 GB  |  jina-clip-v2: ~1.5 GB  |  reranker: ~1.4 GB
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
IMAGE_EMBEDDING_MODEL=jinaai/jina-clip-v2
RERANKER_MODEL=BAAI/bge-reranker-large

# ── Vector Dimensions ────────────────────────────────────────────
TEXT_VECTOR_DIM=1024
IMAGE_VECTOR_DIM=512

# ── Optional: Groq Vision Model (for image classification) ───────
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_MAX_IMAGE_SIDE=1400
VISION_MAX_IMAGE_BYTES=900000

# ── OCR Configuration ────────────────────────────────────────────
OCR_ENABLED=true
OCR_ENGINE=paddle
OCR_MIN_TEXT_LENGTH=80
OCR_MIN_CONFIDENCE=0.60

